# Quick open-source synthesis sanity check for the Zynq-7020 fabric (xc7).
# Real numbers (timing, power) must come from Vivado: software/scripts/vivado_ooc.tcl
read_verilog -Ihardware/rtl/include hardware/rtl/ascon_round.v hardware/rtl/ascon_aead128_core.v hardware/rtl/keystream_gen.v hardware/rtl/tag_unit.v hardware/rtl/rgb2ycbcr_block.v hardware/rtl/dct_stage.v hardware/rtl/dct8x8.v hardware/rtl/quantiser.v hardware/rtl/zigzag_rle.v hardware/rtl/selective_enc.v hardware/rtl/huffman_enc.v hardware/rtl/bit_packer.v hardware/rtl/scan_word_packer.v hardware/rtl/axil_regs.v hardware/rtl/secure_jpeg_top.v
chparam -set LOG_MAXW 11 secure_jpeg_top
synth_xilinx -family xc7 -top secure_jpeg_top -flatten
tee -o sim_build/yosys_utilisation.txt stat
